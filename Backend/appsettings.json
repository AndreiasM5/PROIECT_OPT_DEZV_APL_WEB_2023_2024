{
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=data/store.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedOrigins": [
    "http://localhost:4300",
    "http://127.0.0.1:4300"
  ],
  "AllowedHosts": "localhost;127.0.0.1",
  "JWT": {
    "ValidAudience": "online-store-client",
    "ValidIssuer": "online-store-api"
  }
}

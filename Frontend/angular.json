{
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "store": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "index": "src/index.html",
            "styles": [
              "src/styles.css"
            ],
            "outputPath": "dist/store"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "650kB",
                  "maximumError": "1MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            },
            "pages": {
              "outputHashing": "all",
              "baseHref": "/PROIECT_OPT_DEZV_APL_WEB_2023_2024/",
              "fileReplacements": [
                {
                  "replace": "src/environment.ts",
                  "with": "src/environment.pages.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "store:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
